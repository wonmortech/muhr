{
  "name": "muhr-site",
  "private": true,
  "description": "Tests for the Muhr static site. The site itself has no build step and no runtime dependencies.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node tools/coverage.mjs clean && npm run test:unit && npm run test:e2e && npm run coverage",
    "test:unit": "node tools/coverage.mjs node --test --experimental-test-coverage --test-coverage-include=site/assets/core.js --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "coverage": "node tools/coverage.mjs report",
    "lint": "eslint . --max-warnings 0",
    "check": "node tools/check-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "monocart-coverage-reports": "3.2.0"
  },
  "overrides": {
    "minimatch@^10.0.0": "11.0.3"
  }
}
